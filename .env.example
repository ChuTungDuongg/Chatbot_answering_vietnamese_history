# Choose api-only, retrieval-only, or full. Full loads the preserved indexes.
APP_MODE=api-only
DEVICE=cpu
DTYPE=bfloat16
ARTIFACT_ROOT=./artifacts/vn_history_deployment
RETRIEVAL_DENSE_BACKEND=faiss

# Optional V1 direct paths; leave empty for the V0 bundle defaults.
CORPUS_PATH=
RETRIEVAL_ROOT=
INFERENCE_CONFIG_PATH=
RUNTIME_MANIFEST_PATH=

# Required only when RETRIEVAL_DENSE_BACKEND=qdrant. Use environment values; never commit a real key.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=vn_history_v1_e5
QDRANT_HNSW_EF=

# Optional SILVER annotation semantic endpoint. Keep credentials in local env only.
SILVER_LLM_BASE_URL=http://127.0.0.1:8001/v1
SILVER_LLM_API_KEY=

# Exact vanilla baseline model IDs. Optional revisions can pin hub commits.
HYBRID_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
CENTRAL_MODEL_ID=Qwen/Qwen3-8B
HYBRID_MODEL_REVISION=
CENTRAL_MODEL_REVISION=
MODEL_CACHE_DIR=
MODEL_LOCAL_FILES_ONLY=false
RUNTIME_LOADING_STRATEGY=lazy
DO_SAMPLE=false
ENABLE_THINKING=false
HYBRID_MAX_NEW_TOKENS=768
CENTRAL_ACTION_MAX_NEW_TOKENS=256
CENTRAL_FINAL_MAX_NEW_TOKENS=1536
CENTRAL_MAX_ACTION_ROUNDS=2
ENABLE_HYBRID_MODE=true
ENABLE_CENTRAL_MODE=true
DEFAULT_INFERENCE_MODE=hybrid

# Optional Central tools. Web search requires a configured provider and key.
CENTRAL_ENABLE_DOCUMENTS=true
CENTRAL_ENABLE_WIKIPEDIA=true
CENTRAL_ENABLE_WEB=false
WEB_SEARCH_PROVIDER=local-only
WEB_SEARCH_API_KEY=

CHAT_DATABASE_PATH=./data/chat.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

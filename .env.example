APP_MODE=api-only
DEVICE=cpu
DTYPE=bfloat16
ARTIFACT_ROOT=./artifacts/vn_history_deployment
LLM_BACKEND=transformers
SHARED_BASE_MODEL_ID=Qwen/Qwen3-4B-Instruct-2507
RESEARCH_AGENT_MODEL=Qwen/Qwen3-4B-Instruct-2507
RESEARCH_AGENT_ADAPTER_PATH=
EVIDENCE_AGENT_MODEL=Qwen/Qwen3-4B-Instruct-2507
EVIDENCE_AGENT_ADAPTER_PATH=
HISTORY_AGENT_ADAPTER_PATH=
CENTRAL_AGENT_MODEL_ID=Qwen/Qwen3-8B
CENTRAL_AGENT_ADAPTER_PATH=
CENTRAL_AGENT_HF_CACHE_DIR=
CENTRAL_AGENT_LOCAL_FILES_ONLY=false
RUNTIME_LOADING_STRATEGY=lazy
ENABLE_HYBRID_MODE=true
ENABLE_THREE_LLM_MODE=true
ENABLE_CENTRAL_MODE=true
CENTRAL_AGENT_MAX_ACTION_ROUNDS=2
CENTRAL_AGENT_REPAIR_MAX_GENERATIONS=1
CENTRAL_ACTION_MAX_NEW_TOKENS=256
CENTRAL_FINAL_MAX_NEW_TOKENS=1536
CENTRAL_REPAIR_MAX_NEW_TOKENS=1024
CENTRAL_REPAIR_MIN_NEW_TOKENS=192
CENTRAL_REPAIR_TOKEN_MARGIN=96
CENTRAL_BIOGRAPHY_MAX_SOURCES=4
CENTRAL_BIOGRAPHY_MIN_EXACT_HITS=2
# Raw CrossEncoder scores: only remove a clearly separated tail within one query.
CENTRAL_RERANKER_TAIL_GAP_RATIO=0.75
CENTRAL_RERANKER_SCORE_MODE=raw
# Set CENTRAL_RERANKER_SCORE_FLOOR only with calibrated probability mode, e.g. 0.08.
CENTRAL_RERANKER_STRONG_SCORE=0.5
CENTRAL_AGENT_TIMEOUT_SECONDS=180
CENTRAL_MODEL_LOAD_TIMEOUT_SECONDS=300
CENTRAL_TOOL_TIMEOUT_SECONDS=30
CENTRAL_AGENT_OBSERVATION_CHAR_BUDGET=12000
CENTRAL_AGENT_MAX_TOOL_RESULTS=6
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_API_KEY=
MAX_AGENT_STEPS=6
MAX_WIKIPEDIA_SEARCHES=2
MAX_WEB_SEARCHES=3
MAX_PAGE_FETCHES=5
WEB_SEARCH_PROVIDER=local-only
WEB_SEARCH_API_KEY=
# Modal only: optional Secret name containing WEB_SEARCH_API_KEY.
MODAL_WEB_SEARCH_SECRET_NAME=
DEFAULT_INFERENCE_MODE=central
CHAT_DATABASE_PATH=./data/chat.sqlite3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
